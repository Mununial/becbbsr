# ============================================================
# BEC Website — Root Apache Server Configuration
# Fixes 403 Forbidden on /admin/ & Subpage Routing
# ============================================================

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Prevent Apache directory listing 403 blocks
  Options -Indexes

  # 2. Never cache index.html so updates are instant across devices
  <FilesMatch "index\.html$">
      <IfModule mod_headers.c>
          Header set Cache-Control "no-cache, no-store, must-revalidate"
          Header set Pragma "no-cache"
          Header set Expires 0
      </IfModule>
  </FilesMatch>

  # 3. Bypass API endpoints to Express server
  <IfModule mod_proxy.c>
      RewriteCond %{REQUEST_URI} ^/api [NC]
      RewriteRule ^api/(.*)$ http://localhost:5000/api/$1 [P,L]
  </IfModule>

  # 4. If request is a physical static file under client/dist/, rewrite to it
  RewriteCond %{DOCUMENT_ROOT}/client/dist%{REQUEST_URI} -f
  RewriteRule ^(.*)$ /client/dist/$1 [L]

  # 5. SPA Route Fallback: Rewrite ALL other requests (/admin, /about-college, etc.) to client/dist/index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule . /client/dist/index.html [L]
</IfModule>
